{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "intentface",
  "version": "0.1.0",
  "homepage": "https://intentface.dev",
  "items": [
    {
      "name": "intentface-theme",
      "type": "registry:theme",
      "title": "Intentface theme tokens",
      "hidden": true,
      "cssBlocks": [
        {
          "name": "intentface-theme",
          "sourcePath": "packages/intentface/registry/intentface.css"
        }
      ]
    },
    {
      "name": "intentface-theme-file",
      "type": "registry:item",
      "title": "Intentface theme (standalone CSS file)",
      "files": [
        {
          "sourcePath": "packages/intentface/registry/intentface.css",
          "targetPath": "~/app/intentface.css",
          "type": "registry:file"
        }
      ]
    },
