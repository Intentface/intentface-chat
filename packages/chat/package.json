{
  "name": "@intentface/chat",
  "version": "0.0.0",
  "description": "Headless chat UI primitives — unstyled compound components, hooks, and wire formats for building AI chat interfaces.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "author": "Intentface",
  "homepage": "https://intentface.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Intentface/intentface-chat.git",
    "directory": "packages/chat"
  },
  "bugs": {
    "url": "https://github.com/Intentface/intentface-chat/issues"
  },
  "keywords": [
    "react",
    "chat",
    "ai",
    "headless",
    "ui",
    "components",
    "composer",
    "ai-sdk"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./types": "./src/types.ts",
    "./composer": "./src/composer/index.tsx",
    "./chip": "./src/chip/index.ts",
    "./thread": "./src/thread/index.tsx",
    "./reasoning": "./src/reasoning.tsx",
    "./steps": "./src/steps.tsx",
    "./attachments": "./src/attachments.tsx",
    "./ask-user": "./src/ask-user.tsx",
    "./message": "./src/message.tsx",
    "./message-utils": "./src/message-utils.ts",
    "./chip-markdown": "./src/chip-markdown.ts"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/add-dist-extensions.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run build && node scripts/swap-exports.mjs pre",
    "postpack": "node scripts/swap-exports.mjs post"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "nanoid": "^5.1.11"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.12.1",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./types": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      },
      "./composer": {
        "types": "./dist/composer/index.d.ts",
        "default": "./dist/composer/index.js"
      },
      "./chip": {
        "types": "./dist/chip/index.d.ts",
        "default": "./dist/chip/index.js"
      },
      "./thread": {
        "types": "./dist/thread/index.d.ts",
        "default": "./dist/thread/index.js"
      },
      "./reasoning": {
        "types": "./dist/reasoning.d.ts",
        "default": "./dist/reasoning.js"
      },
      "./steps": {
        "types": "./dist/steps.d.ts",
        "default": "./dist/steps.js"
      },
      "./attachments": {
        "types": "./dist/attachments.d.ts",
        "default": "./dist/attachments.js"
      },
      "./ask-user": {
        "types": "./dist/ask-user.d.ts",
        "default": "./dist/ask-user.js"
      },
      "./message": {
        "types": "./dist/message.d.ts",
        "default": "./dist/message.js"
      },
      "./message-utils": {
        "types": "./dist/message-utils.d.ts",
        "default": "./dist/message-utils.js"
      },
      "./chip-markdown": {
        "types": "./dist/chip-markdown.d.ts",
        "default": "./dist/chip-markdown.js"
      }
    }
  }
}
